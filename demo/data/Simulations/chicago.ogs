# Chicago road network imported from CiudadSim examples/chisincen.net
# (546 nodes, 2176 directed links).
# Pair with chicago.ogs.

resources
	resource Water
	resource Grass
	resource People
	resource Money
	resource Goods
	resource Power
	resource Pollution
	resource Trash
	resource Happiness
end

paths
	path Road color 0xAAAAAA
end

segments
	segment Dirt color 0xAAAAAA speed 30 capacity 20 beta 4
end

agents
	agent People color 0xFFFF00 speed 10
	agent Worker color 0xFFFFFF speed 10
	agent Shopper color 0xFFAA00 speed 12
end

rules

	layerRule CreateGrass
		rate 7
		layer Water remove 10 randomTilesPercent 90
		layer Grass add 1
	end

	layerRule SpreadPollution
		rate 15
		layer Pollution add 1
	end

	layerRule CleanPollution
		rate 20
		layer Pollution remove 1
	end

	layerRule DropDesirability
		rate 10
		layer Pollution greater 20
		layer Desirability remove 2
	end

	layerRule RaiseDesirability
		rate 25
		layer Pollution less 5
		layer Desirability add 1
	end

	unitRule SendPeopleToWork
		rate 20
		hour between 8 18
		local People remove 1
		agent Worker to Work add [ People 1 ]
	end

	unitRule SendPeopleToHome
		rate 40
		hour between 18 22
		local People remove 1
		agent People to Home add [ People 1 ]
	end

	unitRule ProduceGoods
		rate 10
		hour between 8 18
		local People greater 0
		local Goods add 1
		layer Pollution add 4
		global Money add 1
	end

	unitRule UsePeopleToWater
		rate 5
		local People greater 1
		layer Water add 30
	end

	unitRule ShopForGoods
		rate 30
		hour between 10 20
		local People greater 0
		global Money greater 0
		agent Shopper to Shop add [ People 1 ]
	end

	unitRule SellGoods
		rate 8
		local Goods remove 1
		global Money add 2
		local Happiness add 1
	end

	unitRule ReceiveShopper
		rate 15
		local People greater 0
		local People remove 1
		agent People to Home add [ People 1 ]
	end

	unitRule CollectTrash
		rate 40
		layer Trash remove 2
	end

	zoneRule GrowHomes
		rate 80
		count Home less 10
		spawn Home at nearestSegment
	end

	zoneRule GrowShops
		rate 120
		count Shop less 3
		global Money greater 5
		spawn Shop at nearestSegment
	end

	zoneRule AbandonHomes
		rate 100
		layer Desirability less 2
		count Home greater 2
		destroy Home
	end

end

units

	unit Home color 0xFF00FF layerRadius 1 rules [ SendPeopleToWork ShopForGoods ] targets [ Home ] caps [ People 4 Happiness 10 ] resources [ People 4 ]

	unit Work color 0x00AAFF layerRadius 3 rules [ SendPeopleToHome ProduceGoods UsePeopleToWater ] targets [ Work ] caps [ People 4 Goods 20 ] resources [ ]

	unit Shop color 0xFFAA00 layerRadius 2 rules [ SellGoods ReceiveShopper CollectTrash ] targets [ Shop ] caps [ People 6 Goods 30 Happiness 20 ] resources [ ]

end

layers
	layer Water color 0x0000FF capacity 100 rules [  ]
	layer Grass color 0x00FF00 capacity 10 rules [ CreateGrass ]
	layer Pollution color 0x555555 capacity 80 rules [ SpreadPollution ]
	layer Desirability color 0x88FF88 capacity 50 rules [ DropDesirability RaiseDesirability ]
	layer Trash color 0x886644 capacity 40 rules [  ]
	layer Power color 0xFFFF66 capacity 100 rules [  ]
end

zones
	zone Residential color 0x44AA44 rules [ GrowHomes AbandonHomes ]
	zone Commercial color 0xDDAA44 rules [ GrowShops ]
end
